# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repositorio.

# Obligatoria para el chat (demo.ts no la necesita)
ANTHROPIC_API_KEY=

# Opcionales (valor por defecto entre paréntesis)
LLM_PROVIDER=          # (anthropic)
ANTHROPIC_MODEL=       # (claude-haiku-5-5)
MAX_ITERACIONES=       # (25) tope de vueltas herramienta -> modelo por turno
MAX_TOKENS_SESION=     # (300000) tope de tokens por sesión
LLM_TIMEOUT_MS=        # (60000) timeout por llamada al modelo
PORT=                  # (3000)
